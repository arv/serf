{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // The default `correctness` category only: rules that flag code which is
  // outright wrong or dead. `pnpm lint` runs with --deny-warnings and
  // --type-aware, so every one of these breaks the build — keep the set
  // small enough that that stays fair. The `vitest` and `jsx-a11y` plugins
  // are deliberately off: the former reads `expect(value, 'message')`
  // (valid in Vitest) as an arity error, the latter wants markup changes
  // that belong in a change of their own.
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "ignorePatterns": ["dist/**", ".gallery-build/**", "runs/**"],
  "rules": {
    // A leading underscore is how this codebase says "on purpose".
    "no-unused-vars": [
      "warn",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      // Solid binds a DOM ref by assigning to the `let` behind `ref={el}`,
      // which is a compiler transform the rule cannot see — so in the files
      // that hold JSX, every `let el!: HTMLDivElement` reads as unassigned.
      // Everywhere else (the other ~380 files) the rule stays on.
      "files": ["**/*.tsx"],
      "rules": {"no-unassigned-vars": "off"}
    }
  ]
}
