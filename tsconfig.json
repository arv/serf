{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // src/sim and src/shared spell out .ts on their relative imports so the
    // server can load them straight from source, with no build step (see
    // server/tsconfig.json). Legal here because this project is noEmit.
    "allowImportingTsExtensions": true,
    // The campaign's mission maps are JSON files imported by the sim
    // (src/sim/defs/maps/, `with { type: 'json' }` so plain node — the
    // server — loads them too).
    "resolveJsonModule": true,
    // ESNext.TypedArrays for Uint8Array's base64 methods (shared/base64.ts):
    // the map file's tile grids ride as base64 and the platform's own
    // codec is what encodes them where it exists.
    "lib": ["ES2023", "ESNext.TypedArrays", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
