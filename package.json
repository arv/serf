{
  "name": "serf-valley",
  "version": "0.9.0",
  "private": true,
  "description": "A medieval Settlers-like RTS in the browser",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tools/modelLab --noEmit && tsc -p tools/aiLab --noEmit && tsc -p tools/mapAuthor --noEmit && tsc -p tools/perf --noEmit && tsc -p server --noEmit",
    "test": "vitest run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "server": "pnpm --dir server dev",
    "smoke": "pnpm --dir server smoke",
    "bakeoff": "node --experimental-strip-types tools/aiLab/bakeoff.ts",
    "balance": "node --experimental-strip-types tools/aiLab/balance.ts",
    "tiers": "node --experimental-strip-types tools/aiLab/tiers.ts",
    "bakeoff:compare": "node --experimental-strip-types tools/aiLab/compare.ts"
  },
  "dependencies": {
    "solid-js": "^1.9.14",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=23"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
