{
  "compilerOptions": {
    "target": "es2023",
    // ESNext.TypedArrays for Uint8Array's base64 methods — src/shared and
    // src/sim (the map file) are compiled here too.
    "lib": ["es2023", "esnext.typedarrays"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "erasableSyntaxOnly": true
  },
  "include": ["src", "../src/protocol/net.ts", "../src/sim", "../src/shared"],
  // Tests are Vitest's, not the server's — determinism.lint.test.ts uses
  // import.meta.glob, which only exists under Vite.
  "exclude": ["../src/**/*.test.ts"]
}
