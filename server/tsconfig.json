{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "erasableSyntaxOnly": true
  },
  "include": ["src", "../src/protocol/net.ts", "../src/sim", "../src/shared"],
  // Tests are Vitest's, not the server's — determinism.lint.test.ts uses
  // import.meta.glob, which only exists under Vite.
  "exclude": ["../src/**/*.test.ts"]
}
