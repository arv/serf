node_modules/
dist/

# local room persistence (the deploy uses a Railway volume instead)
server/.data/

# build artifacts — sources are TypeScript only
*.js
*.js.map
*.map
*.tsbuildinfo

# ...with one exception: the service worker ships to dist/ verbatim rather
# than through the bundler, so it is authored as plain JS (build/swPlugin.ts
# only fills in its precache manifest).
!src/app/sw.js

# the model lab's bundled gallery (tools/modelLab/build-gallery.mjs)
.gallery-build/

.DS_Store

# bake-off run logs (tools/aiLab)
runs/

# aiLab scratch: one-off seed searches and probes, never committed.
tools/aiLab/scratch/
