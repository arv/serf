# Railway/Railpack serves the Vite build with Caddy; a root Caddyfile
# overrides its default template (same Go-template substitution, so
# {{.DIST_DIR}} still resolves). This copy exists for one reason: the
# sim<->render hot path runs over SharedArrayBuffer, which requires the
# cross-origin-isolation headers below — without them the game refuses to
# boot (see the crossOriginIsolated assert in src/app/main.ts).
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8 # trust railway's proxy
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		# Cross-origin isolation: SharedArrayBuffer needs both of these.
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		X-Content-Type-Options "nosniff"
		-Server
	}

	root * {{.DIST_DIR}}

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html{{if .IndexFallback}} /index.html{{end}}
}
